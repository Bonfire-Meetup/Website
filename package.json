{
  "name": "bnf-homepage-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check": "oxlint . && oxfmt --check . && tsc --noEmit",
    "fix": "oxlint --fix . && oxfmt --write .",
    "postinstall": "mkdir -p public/vendor && cp node_modules/zxing-wasm/dist/reader/zxing_reader.wasm public/vendor/",
    "clean": "bun pm cache rm && rm -rf node_modules bun.lock && bun install",
    "email:dev": "email dev --dir app/components/email",
    "photos:refresh-data": "node scripts/refresh-photo-albums-data.mjs",
    "socials:generate": "node scripts/socials/generate.mjs"
  },
  "dependencies": {
    "@babel/parser": "^8.1.2",
    "@babel/types": "^8.1.2",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@neondatabase/serverless": "^1.2.0",
    "@next/mdx": "16.4.6",
    "@react-email/components": "1.0.12",
    "@reduxjs/toolkit": "^2.14.0",
    "@rollbar/react": "^1.2.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@types/mdx": "^2.0.14",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "@yudiel/react-qr-scanner": "^2.6.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "botid": "^1.5.13",
    "drizzle-orm": "^0.45.4",
    "geist": "^1.9.2",
    "jose": "^6.2.17",
    "next": "^16.4.6",
    "next-intl": "^4.15.1",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.3",
    "postcss": "^8.5.32",
    "prop-types": "^15.8.1",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-redux": "^9.3.1",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^6.0.0",
    "rollbar": "^4.2.1",
    "sharp": "^0.35.5",
    "stripe": "^23.1.0",
    "tailwindcss": "^4.3.5",
    "ua-parser-js": "^2.0.10",
    "web-haptics": "^0.0.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@react-email/preview-server": "5.2.10",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.72.2",
    "cssnano": "^9.9.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "react-email": "6.11.12",
    "typescript": "^7.0.2"
  },
  "next-intl": {
    "locales": [
      "en",
      "cs"
    ],
    "defaultLocale": "en",
    "localePrefix": "never"
  }
}
